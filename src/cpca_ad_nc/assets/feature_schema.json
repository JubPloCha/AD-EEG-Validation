  "features": [
    {
      "type": "absolute_power",
      "count": 64,
      "name_pattern": "power_log10_{band}_{channel}",
      "unit": "log10(µV²)",
      "definition": "For each 1-second Hann window, compute one-sided PSD using fs*sum(window^2), integrate with linearly interpolated band edges, take log10, then average log power across valid windows. EEG input scale follows EEGLAB stored values; external scale must be verified against the processed source."
    },
    {
      "type": "relative_power",
      "count": 64,
      "name_pattern": "relative_log10_{band}_{channel}",
      "unit": "log10(dimensionless fraction)",
      "definition": "Band-integrated power divided by integrated 1-45 Hz power within each window; log10 then average across windows."
    },
    {
      "type": "spectral_entropy",
      "count": 64,
      "name_pattern": "spectral_entropy_{band}_{channel}",
      "unit": "normalized dimensionless",
      "definition": "Entropy of normalized one-sided Hann PSD bins within the named band, divided by log(number of bins), then averaged across windows."
    },
    {
      "type": "debiased_squared_wpli",
      "count": 480,
      "name_pattern": "dwpli2_{band}_{channel_1}__{channel_2}",
      "unit": "signed dimensionless estimator in [-1,1]",
      "definition": "Vinck-style debiased squared wPLI from the imaginary cross-spectrum across 1-second windows at each band bin, then average over bins. The edge is undirected and stored once with channel_1 preceding channel_2 in schema order."
    },
    {
      "type": "hjorth_complexity",
      "count": 80,
      "name_pattern": "hjorth_complexity_{broad_or_band}_{channel}",
      "unit": "dimensionless",
      "definition": "sqrt(var(second difference)/var(first difference))/sqrt(var(first difference)/var(signal)); broad is calculated on the input window; band-specific values use fourth-order Butterworth zero-phase band-pass filtering of each window before the same formula."
    }
  ],
  "counts": {
